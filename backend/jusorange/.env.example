# Variables d'environnement backend (VPS)
# Copier en .env sur le serveur — NE JAMAIS committer le .env réel.

SECRET_KEY=changez-moi-en-production
DEBUG=False

# Hôtes autorisés à servir l'application, séparés par des virgules.
# L'IP reste listée : elle sert à diagnostiquer sans dépendre du DNS.
ALLOWED_HOSTS=jus.gdamali.net,194.163.187.59,localhost,127.0.0.1

# PostgreSQL installé sur le VPS (port 5433 : le 5432 est déjà pris par Docker)
DATABASE_URL=postgresql://jusorange:MOT_DE_PASSE@127.0.0.1:5433/jusorange

# URL publique du frontend Next.js (pour l'autorisation CORS)
FRONTEND_URL=https://jus.gdamali.net

# Origines de confiance pour le CSRF (admin Django et formulaires).
# L'application reste joignable en http par l'IP : les trois origines sont donc
# nécessaires.
CSRF_TRUSTED_ORIGINS=http://jus.gdamali.net,https://jus.gdamali.net,http://194.163.187.59

# Marque les cookies de session et de CSRF « Secure ». À passer à True
# UNIQUEMENT après avoir obtenu un certificat via certbot : sinon plus aucun
# login possible sur l'admin Django.
ENABLE_HTTPS=True
