APP_NAME="Campagne BDM"

# À générer une seule fois :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=campagne.example.ml

# Base de production — la MÊME que celle utilisée par Laravel.
# Le schéma métier est identique : aucune migration de données n'est nécessaire.
DB_HOST=db
DB_PORT=3306
DB_NAME=bdm
DB_USER=bdm
DB_PASSWORD=

# Les assets sont compilés dans l'image : pas de serveur Vite en production.
VITE_DEV=false
