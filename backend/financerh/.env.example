DJANGO_SECRET_KEY=changez-cette-cle-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Abidjan

# Autorise les mots de passe triviaux (recette uniquement).
# Vaut DJANGO_DEBUG par defaut ; DOIT etre False en production.
DJANGO_MOTS_DE_PASSE_SIMPLES=True

# Base de donnees. Laisser vide pour retomber sur SQLite.
# Pile Supabase locale (docker compose up -d a la racine du depot) :
# DATABASE_URL=postgres://postgres:financerh-local@127.0.0.1:5434/postgres
DATABASE_URL=postgres://postgres:financerh-local@127.0.0.1:5434/postgres

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
